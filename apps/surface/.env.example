# ─────────────────────────────────────────────────────────────────────────────
# surface — environment variable template
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL
# Points to the `core` Express server.
# Must be prefixed with NEXT_PUBLIC_ to be available in the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ImageKit configuration (for image uploads)
# Replace these with your actual ImageKit credentials and URL endpoint.
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=your_url_endpoint